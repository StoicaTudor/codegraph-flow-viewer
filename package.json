{
  "name": "codegraph-flow-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=262144 concurrently -k \"vite\" \"tsx server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_OPTIONS=--max-http-header-size=262144 tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
